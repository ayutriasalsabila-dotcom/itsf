function show(i){cur=i;$$('#secs section').forEach((s,j)=>s.classList.toggle('hide',j!==i));$$('#st div').forEach((d,j)=>d.className=j===i?'on':j<i?'done':'');$('#pg').style.width=(i+1)/S.length*100+'%';$('#bk').style.visibility=i?'visible':'hidden';$('#nx').textContent=i===S.length-1?'🚀 Kirim Pendaftaran':'Lanjut ➡';scrollTo({top:0,behavior:'smooth'})}
const ok=()=>$$('#secs section')[cur].querySelectorAll('input,select').length&&[...$$('#secs section')[cur].querySelectorAll('input,select')].every(e=>e.reportValidity());
const rd=x=>new Promise(r=>{if(!x)return r(null);if(x.type.startsWith('image/')){const im=new Image;im.onload=()=>{const k=Math.min(1,1400/Math.max(im.width,im.height)),c=document.createElement('canvas');c.width=im.width*k;c.height=im.height*k;c.getContext('2d').drawImage(im,0,0,c.width,c.height);r({name:x.name.replace(/\.\w+$/,'')+'.jpg',mime:'image/jpeg',data:c.toDataURL('image/jpeg',.75).split(',')[1]})};im.src=URL.createObjectURL(x)}else{const fr=new FileReader;fr.onload=()=>r({name:x.name,mime:x.type,data:fr.result.split(',')[1]});fr.readAsDataURL(x)}});
async function send(){
 if(typeof google==='undefined'||!google.script){alert('Buka form ini lewat link Web App yang resmi');return}
 const b=$('#nx');b.disabled=true;b.textContent='⏳ Mengirim...';
 try{
  const d={};$$('[name]').filter(e=>!e.closest('.pl')||e.name.startsWith('o')).forEach(e=>{if(e.type!=='file')d[e.name]=e.type==='checkbox'?(e.checked?'Setuju':''):e.value});
  const players=[];for(const c of $$('#pls .pl')){const g=n=>c.querySelector('[name='+n+']');players.push({nama:g('nama').value,nim:g('nim').value,no:g('no').value,ktm:await rd(g('ktm').files[0])})}
  const bukti=await rd($('[name=bukti]').files[0]);
  const j=await new Promise((a,z)=>google.script.run.withSuccessHandler(a).withFailureHandler(z).submit(JSON.stringify({d,players,bukti})));if(!j.ok)throw new Error(j.error);
  $('#app').classList.add('hide');$('#done').classList.remove('hide');$('#kode').textContent=j.id;scrollTo(0,0);
 }catch(err){alert('Gagal mengirim: '+err.message+'\nCoba lagi ya.');b.disabled=false;b.textContent='🚀 Kirim Pendaftaran'}
}
$('#nx').onclick=()=>{if(!ok())return;cur<S.length-1?show(cur+1):send()};
$('#bk').onclick=()=>show(cur-1);
show(0);
